{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-d3d12",
      "displayName": "SpudGPU Samples Windows D3D12",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-windows-d3d12",
      "cacheVariables": {
        "GRAPHICS_BACKEND": "D3D12",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo"
      }
    },
    {
      "name": "windows-vulkan",
      "displayName": "SpudGPU Samples Windows Vulkan",
